{
  "name": "gondolapro",
  "productName": "GôndolaPro",
  "version": "1.0.0",
  "description": "Gerador visual de layouts de etiqueta para o SysPDV",
  "author": "PBtec",
  "license": "SEE LICENSE IN LICENSE.txt",
  "private": true,
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "dist": "electron-vite build && electron-builder --win"
  },
  "build": {
    "appId": "br.com.pbtec.gondolapro",
    "productName": "GôndolaPro",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*"
    ],
    "extraResources": [
      {
        "from": "resources",
        "to": "resources"
      },
      {
        "from": "docs/user-manual.pdf",
        "to": "resources/user-manual.pdf"
      },
      {
        "from": "LICENSE.txt",
        "to": "LICENSE.txt"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "resources/icon.ico"
    },
    "nsis": {
      "artifactName": "GondolaPro-Setup-${version}.${ext}",
      "license": "LICENSE.txt",
      "installerLanguages": [
        "pt_BR"
      ],
      "language": "1046"
    }
  },
  "dependencies": {
    "jsbarcode": "^3.12.3",
    "konva": "^10.11.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-konva": "^19.3.2"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1"
  }
}
